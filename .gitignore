# Dependencies
node_modules/
web/node_modules/

# ResumeBuilderV2 source repos, cloned here only to port the builder into web/.
# They carry their own .git, venv/, node_modules/ and .env with live secrets —
# committing them would leak the Mongo URI, NVIDIA key and Razorpay secrets.
ResumeBuilderV2-Backend/
ResumeBuilderV2-Frontend/

# Next.js
web/.next/
web/out/
web/build/

# Env & secrets (never commit)
.env
.env.*
!.env.example
!**/.env.example
web/.env.local
web/.env*.local
*.pem

# LLM bakeoff artifacts (local only)
bakeoff-out/

# Local SQLite / app data
web/data/
*.db
*.db-*
*.sqlite
*.sqlite3

# Vercel / misc
.vercel/
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript
*.tsbuildinfo
web/next-env.d.ts

